{
  "name": "pockethost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "PocketHost foundation, documentation and quality gates",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:structure": "node scripts/quality/check-structure.mjs",
    "check:docs": "node scripts/quality/check-docs.mjs",
    "check:boundaries": "node scripts/quality/check-boundaries.mjs",
    "check:foundation": "npm run check:structure && npm run check:docs && npm run check:boundaries && npm test",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "markdownlint": "markdownlint-cli2 \"README.md\" \"CONTRIBUTING.md\" \"SECURITY.md\" \"AGENTS.md\" \"docs/**/*.md\" \"src/**/AGENTS.md\" \"scripts/**/AGENTS.md\" \"tests/**/AGENTS.md\" \"apps/AGENTS.md\"",
    "test": "node --test tests/quality/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage tests/quality/*.test.mjs",
    "test:coverage:gate": "node --test --experimental-test-coverage --test-coverage-lines=75 --test-coverage-branches=78 --test-coverage-functions=78 tests/quality/*.test.mjs",
    "audit:knip": "npm exec --yes --package=knip@6.43.0 -- knip --reporter compact",
    "check": "npm run check:foundation && npm run markdownlint && npm run format:check && npm run lint && npm run typecheck",
    "admin:import": "node scripts/import-shadcnstore.mjs",
    "admin:dev": "npm --prefix apps/admin run dev -- --host 127.0.0.1 --port 8787 --strictPort",
    "admin:build": "npm --prefix apps/admin run build",
    "admin:lint": "npm --prefix apps/admin run lint",
    "check:all": "npm run check && npm run test:coverage:gate && npm run admin:lint && npm run admin:build && npm --prefix apps/admin run test:ui",
    "dev:quick": "node --test tests/quality/admin-preservation.test.mjs",
    "dev:ui": "npm --prefix apps/admin run test:ui",
    "dev:full": "npm run check:all",
    "dev:panel": "npm run admin:dev",
    "dev:sync": "node scripts/dev/ui-sync.mjs --watch --interval-ms=8000",
    "dev:sync:once": "node scripts/dev/ui-sync.mjs --once",
    "dev:sync:test": "node --test tests/quality/dev-ui-sync.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3"
  }
}
